# Copie para .env e ajuste. Só estas quatro variáveis são lidas pelo código.

# String de conexão do MongoDB (obrigatória).
# Local: mongodb://localhost:27017. Em produção, a string do cluster fica
# configurada nas variáveis de ambiente da Lambda (nunca neste arquivo).
MONGODB_URI=mongodb://localhost:27017

# Nome do banco onde fica a coleção raw_crawls (obrigatória).
# Precisa ser o mesmo usado pelo processador NLP e pela API (padrão: role_sc).
MONGODB_DB_NAME=role_sc

# Só para o Firefox local (ignoradas na Lambda, onde o Chromium é sempre headless).
# HEADLESS=false abre a janela do navegador; qualquer outro valor roda headless.
HEADLESS=true
# Atraso em ms entre as ações do navegador (útil para depuração visual).
SLOW_MO=0

# Não defina AWS_LAMBDA_FUNCTION_NAME localmente: ela é injetada pela AWS e,
# se existir, o crawler tenta usar o Chromium da Lambda em vez do Firefox.
